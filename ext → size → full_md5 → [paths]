import os
import hashlib
import xxhash
from collections import defaultdict

def _light_hash(path, chunk_size=16 * 1024):
    """Compute xxhash64 on the first chunk_size bytes."""
    with open(path, "rb") as f:
        data = f.read(chunk_size)
    return xxhash.xxh64(data).hexdigest()

def _full_md5(path, block_size=8192):
    """Compute full‐file MD5 in streaming mode."""
    h = hashlib.md5()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(block_size), b""):
            h.update(chunk)
    return h.hexdigest()

def index_by_size_then_hash(root_dir, light_chunk=16*1024):
    """
    Build an index of all files under root_dir:
      { ext: { size: { full_md5: [path, …] } } }
    with a two‐stage filter (size → light hash → full MD5).
    """
    # 1) Gather by ext and size
    size_buckets = defaultdict(lambda: defaultdict(list))
    for dirpath, _, files in os.walk(root_dir):
        for name in files:
            path = os.path.join(dirpath, name)
            ext = os.path.splitext(name)[1].lower()
            size = os.path.getsize(path)
            size_buckets[ext][size].append(path)

    # 2) Refine with light hash and then full MD5
    index = defaultdict(lambda: defaultdict(lambda: defaultdict(list)))
    for ext, sizes in size_buckets.items():
        for size, paths in sizes.items():
            if len(paths) == 1:
                # Only one file of this size → full hash directly
                p = paths[0]
                md5 = _full_md5(p)
                index[ext][size][md5].append(p)
            else:
                # Multiple files same size → do first‐chunk hash
                light_buckets = defaultdict(list)
                for p in paths:
                    lh = _light_hash(p, chunk_size=light_chunk)
                    light_buckets[lh].append(p)

                for lh, group in light_buckets.items():
                    if len(group) == 1:
                        # Unique on light‐hash → full MD5
                        p = group[0]
                        md5 = _full_md5(p)
                        index[ext][size][md5].append(p)
                    else:
                        # Real collision → full MD5 on each
                        for p in group:
                            md5 = _full_md5(p)
                            index[ext][size][md5].append(p)

    return index